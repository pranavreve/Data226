<?xml version="1.0" encoding="utf-8"?>
<services version="1.0">
    <!-- Container Cluster for HTTP and Document API -->
    <container id="default" version="1.0">
        <document-api />
        <search />
        <http>
            <server port="8080" id="default" />
        </http>
        <nodes count="1" />
    </container>
    
    <!-- Content Cluster for Document Storage and Search -->
    <content id="search" version="1.0">
        <redundancy>2</redundancy> <!-- Adjust based on availability requirements -->
        <documents>
            <document type="doc" mode="index" />
        </documents>
        <engine>
            <proton>
                <query-timeout>5.0</query-timeout> <!-- Adjust timeout as needed -->
            </proton>
        </engine>
        <nodes count="1" />
    </content>
</services>
